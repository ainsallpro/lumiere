# Koneksi ke database PostgreSQL lokal
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Ganti dengan username dan password asli komputermu
DATABASE_URL="postgresql://postgres:password123@localhost:5432/furniter_db?schema=public"

PORT=5000

# Google OAuth Client ID (Dapatkan dari Google Cloud Console)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"

# URL Frontend (untuk link reset password)
CLIENT_URL="http://localhost:8443"

# Konfigurasi SMTP Email (Kosongkan saat development untuk melihat link di terminal console)
# Contoh jika memakai Gmail: buat "App Password" di https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Lumière Furniture" <no-reply@lumiere.com>'
